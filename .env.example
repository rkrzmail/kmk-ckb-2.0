# ==============================================================================
# ENVIRONMENT VARIABLES - kmk-ckb-api
# Security issue #2/#9 (SECURITY.md): secret TIDAK lagi hardcoded di yaml.
# Prod & brahma WAJIB meng-set variabel di bawah ini sebelum deploy - tanpa
# fallback di yaml, aplikasi akan gagal start / integrasi gagal jika kosong.
#
# Nilai = kredensial yang SAMA dengan sebelumnya (belum rotasi).
# Rotasi nilai dilakukan di sini (env/secret manager), bukan di yaml.
# ==============================================================================

# ---- Spring ----
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/kmkds?stringtype=unspecified
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# ---- Security (JWT / API key) ----
# jwt.secret-key  : HMAC HS256 signing key (hex/base64 256-bit)
# secret-key      : shared secret untuk bypass token loan-submission (MD5 legacy, issue #12)
# api.key         : nilai API-Key yang dikirim klien pada header ApiKey/API-Key
SECURITY_JWT_SECRET_KEY=
SECURITY_SECRET_KEY=
SECURITY_API_KEY=

# ---- Spring Boot Admin ----
BOOT_ADMIN_URL=http://localhost:9000
BOOT_ADMIN_USERNAME=
BOOT_ADMIN_PASSWORD=

# ---- Sistem internal ----
SISCA_PASSWORD=
TESTING_MAIL_PASSWORD=
CONFINS_ADINS_KEY=
# Brahma memakai nama properti adin-key (beda dari prod adinskey)
CONFINS_ADIN_KEY=

# ---- Opsional (default aman sudah diset di yaml) ----
# MANAGEMENT_ENDPOINTS_INCLUDE=info,health
# FEIGN_LOGGER_LEVEL=BASIC
# CORS_ALLOWED_ORIGINS=https://danasakti.csulfinance.com
# REDIS_HOST= / REDIS_PORT= / REDIS_PASSWORD=
# MONGO_HOST= / MONGO_PORT= / MONGO_DATABASE=
