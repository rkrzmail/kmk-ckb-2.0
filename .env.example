# Example Environment Variables for Local Development
# Copy to .env and adjust as needed:
# cp .env.example .env

# App & Profile
APP_ENV=local
SPRING_PROFILES_ACTIVE=local

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/kmkds?stringtype=unspecified
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Redis & Mongo
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=6
REDIS_PASSWORD=
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=kmklog

