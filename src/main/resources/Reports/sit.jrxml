	<columnHeader>
		<band height="423" splitType="Stretch">
			<textField textAdjust="StretchHeight">
				<reportElement x="0" y="51" width="450" height="138" uuid="971f916e-c9f4-4ab7-ba10-e69a463f3db4"/>
				<textElement textAlignment="Justified" markup="html">
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Dengan hormat,<br/><br/>Sehubungan dengan telah ditandatanganinya Perjanjian Pembiayaan Modal Kerja dengan Fasilitas Pembiayaan Anjak Piutang (<i>\"With Recourse\"</i>) nomor <b>" + $P{nomorPerjanjian} + "</b> tanggal <b>" + $P{tanggalPerjanjian} + "</b> berikut perubahan (-perubahannya), perpanjangan (-perpanjangan), penambahan (-penambahannya) (jika ada) beserta setiap dan seluruh dokumen-dokumen turunannya (<b>\"Perjanjian Pembiayaan\"</b>) antara <b>PT. Chandra Sakti Utama Leasing</b> selaku <b>\"Factor\"</b> dan <b>" + $P{companyDebitur} + "</b> selaku <b>\"Klien\"</b> maka berdasarkan surat ini mohon agar pembayaran jasa pekerjaan <b>" + $P{companyDebitur} + "</b>, dapat dibayarkan/ditransfer kepada <b>Factor</b> sebagai pembayaran kewajiban sebagaimana tercantum dalam Perjanjian Pembiayaan di atas ke rekening dengan rincian sebagai berikut:"]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="10" width="40" height="15" uuid="edd895c8-0a3d-4477-9f82-c8a3dabee558">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement>
					<font isBold="false"/>
				</textElement>
				<text><![CDATA[Up. :]]></text>
			</staticText>
			<textField>
				<reportElement x="30" y="10" width="420" height="15" uuid="7650a784-7408-47e5-89a9-4e4117f4c956"/>
				<textElement>
