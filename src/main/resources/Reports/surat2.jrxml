	<detail>
		<band height="342" splitType="Stretch">
			<staticText>
				<reportElement x="0" y="150" width="450" height="40" uuid="7605cc34-a489-4dda-882b-689b2fea2e38"/>
				<text><![CDATA[Demikian kami sampaikan. Atas perhatian dan kerja samanya, kami ucapkan terima kasih.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="209" width="200" height="20" uuid="55dfa24b-077c-4987-a930-9376f92c6c6c">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[PT Chandra Sakti Utama Leasing]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="189" width="200" height="20" uuid="e1023382-d7e3-4e39-a05e-c3e0b2ef60f3"/>
				<text><![CDATA[Hormat Kami,]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="0" y="80" width="450" height="70" uuid="e595d029-bcf6-46a2-a178-58b02ded0b06"/>
				<textElement textAlignment="Justified" markup="html">
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Surat Persetujuan ini merupakan satu-kesatuan dan bagian yang tidak terpisahkan dari Perjanjian Pembiayaan dengan Fasilitas Pembiayaan Anjak Piutang Dengan Jaminan (<i>With Recourse</i>) nomor "+ $P{Cwr} +" tanggal "+ $P{Cwr-Date} +" beserta setiap dan seluruh dokumen-dokumen turunannya (“<b>Perjanjian</b>”), dan oleh karenanya hal-hal yang telah diatur dalam Perjanjian termasuk tetapi tidak terbatas pada biaya-biaya yang dibebankan tetap dinyatakan berlaku dan mengikat <b>Klien</b>."]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight">
				<reportElement x="0" y="0" width="450" height="60" uuid="64d8dfc3-cbbb-4c6b-9fad-612b1b3d6c5d"/>
				<textElement textAlignment="Justified">
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Dengan Hormat,\n\nMerujuk kepada surat saudara Nomor. " + $P{AppNo} + " tanggal " + $P{TglDokumen} + " perihal Penawaran Pengalihan Piutang (Anjak Piutang/Factoring), dengan ini kami beritahukan bahwa kami telah menyetujui untuk menerima pengalihan piutang yang telah diajukan saudara dengan syarat-syarat dan ketentuan-ketentuan sebagaimana terlampir."]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="0" y="300" width="250" height="1" uuid="088c989a-a44f-4bdd-b27e-d7a4fde19ac2"/>
