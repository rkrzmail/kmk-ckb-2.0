			<textField>
				<reportElement x="260" y="100" width="200" height="330" uuid="3c9fe189-b8ad-4888-b63d-b64de1265d78">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
					<property name="net.sf.jasperreports.text.adjust.spacedJustify" value="false"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top" markup="none">
					<font size="10"/>
					<paragraph lineSpacing="Proportional" lineSpacingSize="1.1"/>
				</textElement>
				<textFieldExpression><![CDATA["Klien akan membayar denda keterlambatan jika tidak membayar pembayaran sesuai dengan tanggal jatuh tempo;\n" +
"Apabila Klien melakukan cidera janji terhadap Perjanjian Pembiayaan (menungg-\n"+
"ak), maka Klien harus menyerahkan Barang dan/atau Jaminan kepada Factor;\n" +
"Jika Klien tidak menyerahkan, maka Factor akan melakukan eksekusi terhadap Barang dan/atau Jaminan;\n" +
"Klien akan dibebankan biaya eksekusi jika terjadi eksekusi Barang dan/atau Jaminan;\n" +
"Data atau informasi Klien akan digunakan penawaran produk atau keperluan lainnya sepanjang diperbolehkan oleh undang-undang;\n" +
"Apabila Klien melakukan cidera janji terhadap Perjanjian Pembiayaan (menungg-\n"+
"ak) akan mempengaruhi status kolektabilitas Klien pada data SLIK OJK."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="140" y="100" width="100" height="15" uuid="84a1f309-22f4-424f-8b83-a5a12ed1af0f">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textFieldExpression><![CDATA[$P{Limit}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="140" y="145" width="100" height="15" uuid="3f4bf84f-dc78-4488-93e2-92b1e37ea509">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textFieldExpression><![CDATA[$P{Notaris}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="140" y="160" width="100" height="15" uuid="e72803f7-bcb0-4753-aa72-00356374666a">
