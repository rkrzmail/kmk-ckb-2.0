	<detail>
		<band height="480" splitType="Stretch">
			<staticText>
				<reportElement x="3" y="59" width="450" height="20" uuid="10333d2b-9d21-472e-9c68-e14066767509"/>
				<textElement>
					<font size="12" isBold="true"/>
				</textElement>
				<text><![CDATA[II. 	Pernyataan]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement x="3" y="79" width="450" height="80" uuid="23c7cf9f-b526-465d-ad1e-3d569d4cd2c0"/>
				<textElement textAlignment="Justified"/>
				<textFieldExpression><![CDATA["Saya/Kami dengan ini menyatakan bahwa semua informasi di atas bersama dokumen penunjang sehubungan dengan keterangan-keterangan tersebut di atas adalah benar, lengkap, serta sesuai dengan aslinya dan dengan ini memberikan kuasa kepada CSUL untuk melakukan pengecekan terhadap pihak-pihak yang tercantum dalam Formulir Aplikasi Pembiayaan, pemeriksaan informasi Debitur berikut pelaporan ke dalam Sistem Layanan Informasi Keuangan, termasuk tetapi tidak terbatas pada pelaporan-pelaporan lainnya yang diwajibkan oleh Regulator."]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight">
				<reportElement x="3" y="159" width="450" height="120" uuid="6257d86c-731f-4b53-8299-c67771a3c964"/>
				<textElement textAlignment="Justified"/>
				<textFieldExpression><![CDATA["Pemohon dengan ini menyatakan, tanpa dapat dibatalkan, dicabut kembali atau diubah dengan alasan apapun dan dalam keadaan apapun, bahwa Pemohon tidak pernah dan/atau tidak akan pernah memberikan dan/atau janji memberikan suatu imbalan tidak resmi, baik secara langsung maupun tidak langsung, baik tersirat maupun tersurat, antara lain tetapi tidak terbatas pada pemberian dalam bentuk uang, barang, hak-hak, fasilitas-fasilitas dan/atau segala sesuatu yang dapat ditafsirkan sebagai imbalan yang menguntungkan dan/atau dapat menyebabkan keuntungan pribadi kepada Komisaris, Direksi, Karyawan CSUL yang diduga dan/atau dapat diduga berkaitan dengan pembiayaan yang diberikan oleh CSUL kepada Pemohon."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="233" y="281" width="220" height="15" uuid="28ab5a12-759e-4c94-80da-677e9f76831b"/>
				<text><![CDATA[Tempat/Tanggal]]></text>
			</staticText>
			<staticText>
				<reportElement x="233" y="301" width="220" height="15" uuid="6dad02ab-9359-492b-aac5-7f706a40d559"/>
				<text><![CDATA[Diajukan oleh :]]></text>
			</staticText>
