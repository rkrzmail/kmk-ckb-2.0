	<columnHeader>
		<band height="285" splitType="Stretch">
			<textField textAdjust="StretchHeight">
				<reportElement x="0" y="51" width="450" height="138" uuid="971f916e-c9f4-4ab7-ba10-e69a463f3db4"/>
				<textElement textAlignment="Justified" markup="html">
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Dengan hormat,<br/><br/>Sehubungan dengan Fasilitas Danasakti berdasarkan Perjanjian Pembiayaan Modal Kerja dengan Fasilitas Pembiayaan Anjak Piutang berikut perubahan (-perubahannya), perpanjangan (- perpanjangan), penambahan (-penambahannya) (jika ada) beserta setiap dan seluruh dokumen-dokumen turunannya (<b>\"Fasilitas Danasakti\"</b>) yang diberikan oleh <u>" + $P{NamaGMFinance}  + "</u> selaku <b>\"Factor\"</b> kepada kami selaku <b>\"Klien\"</b> dengan objek pembiayaan berupa invoice (terlampir), maka berdasarkan surat ini mohon agar pembayaran jasa pekerjaan <u><b>Klien</b></u> dengan total sebesar <u>" + $P{TotalPembayaran}  + "</u>, sesuai dengan detail informasi yang tertera pada lampiran dapat dibayarkan/ditransfer kepada Factor sebagai pembayaran kewajiban yang timbul atas Fasilitas Pembiayaan di atas dengan rincian sebagai berikut:"]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="10" width="40" height="15" uuid="edd895c8-0a3d-4477-9f82-c8a3dabee558">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement>
					<font isBold="false"/>
				</textElement>
				<text><![CDATA[Up. :]]></text>
			</staticText>
			<textField>
				<reportElement x="30" y="10" width="420" height="15" uuid="7650a784-7408-47e5-89a9-4e4117f4c956"/>
